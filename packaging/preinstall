#!/bin/bash
set -euo pipefail
# Never stop a running keep-awake process: a closed MacBook could sleep immediately.
if /usr/bin/pgrep -x Caffeine >/dev/null; then
    echo 'Caffeine is running. Open the lid, quit Caffeine from its menu, then run this installer again.' >&2
    exit 1
else
    result=$?
    if [ "$result" -ne 1 ]; then
        echo 'Cannot check whether Caffeine is running. Installation stopped for safety.' >&2
        exit 1
    fi
fi
exit 0
